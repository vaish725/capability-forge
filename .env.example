# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Anthropic API key used by discovery mode (not required for offline replay against fixtures).
ANTHROPIC_API_KEY=

# No target-UI credentials belong here. An artifact that needs a login declares it as typed inputs
# and takes the values at replay time via --params (e.g. parabank_check_account_balance.json takes
# username and password); they are never written to artifacts, logs, or transcripts.
